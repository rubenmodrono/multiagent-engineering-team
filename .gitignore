# ─────────────────────────────────────────────────────────────
# This repository is a template. The client's documents are
# never part of it.
#
# docs/deliverables/ exists to hold the real deliverables while
# work is in progress. Its contents are never versioned here.
# ─────────────────────────────────────────────────────────────

docs/deliverables/*
!docs/deliverables/README.md

# Office documents and exports: they come in as working material
# and must not leave the disk of whoever is using them.
*.docx
*.doc
*.pdf
*.xlsx
*.pptx
*.odt

# Template profiles already extracted: they carry the client's
# document structure. The empty versions are versioned.
docs/templates/*.extracted.yaml

# A matrix loaded with real requirements. The sample one is versioned.
docs/traceability/matrix.local.csv

# Environments and secrets
.env
.env.*
*.pem
*.key
kubeconfig*
*secret*.yaml

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# macOS
.DS_Store
